install.packages("fastshap")
install.packages("ggplot2")
install.packages("ggplot2")
library(tidyverse)
library(caret)
library(randomForest)
library(pROC)
library(fastshap)
print("正在加载模型...")
model_rf <- readRDS("final_model.rds")
data <- read.csv("cleaned_diabetes_data.csv", stringsAsFactors = TRUE)
set.seed(123)
small_idx <- createDataPartition(data$readmitted_binary, p = 0.05, list = FALSE)
plot_data <- data[small_idx, ]
print("正在绘制 ROC 曲线...")
probs <- predict(model_rf, plot_data, type = "prob")
roc_obj <- roc(plot_data$readmitted_binary, probs$Yes)
pdf("Result_ROC_Curve.pdf", width = 6, height = 6)
plot(roc_obj, print.auc = TRUE, main = "ROC Curve for Diabetes Prediction", col = "blue")
dev.off()
print("图片 'Result_ROC_Curve.pdf' 已保存。")
print("正在绘制特征重要性...")
imp <- varImp(model_rf)
pdf("Result_Feature_Importance.pdf", width = 8, height = 6)
plot(imp, top = 15, main = "Top 15 Most Important Features")
dev.off()
print("图片 'Result_Feature_Importance.pdf' 已保存。")
print("正在计算 SHAP 值 (这个稍微有点慢，请等一下)...")
pred_wrapper <- function(object, newdata) {
predict(object, newdata, type = "prob")$Yes
}
X <- plot_data %>% select(-readmitted_binary)
bad <- nearZeroVar(X)
if(length(bad) > 0) X <- X[, -bad]
shap_vals <- explain(model_rf, X = X, pred_wrapper = pred_wrapper, nsim = 10)
print("正在绘制 SHAP 图...")
print("正在绘制 SHAP 图...")
pdf("Result_SHAP_Summary.pdf", width = 8, height = 6)
autoplot(shap_vals, type = "contribution") +
ggtitle("SHAP Value Summary (Model Interpretation)")
dev.off()
print("🎉 全部完成！请查看文件夹里的 PDF 图片文件。")
library(ggplot2)
shap_df <- as.data.frame(shap_vals)
importance_scores <- data.frame(
Feature = names(shap_df),
Importance = colMeans(abs(shap_df))
)
print("正在重新绘制 SHAP 图...")
pdf("Result_SHAP_Summary.pdf", width = 8, height = 6)
p <- ggplot(importance_scores, aes(x = reorder(Feature, Importance), y = Importance)) +
geom_col(fill = "#0073C2") +
coord_flip() +
labs(
title = "SHAP Value Summary (Global Importance)",
x = "Features",
y = "mean(|SHAP value|)"
) +
theme_minimal()
print(p)
dev.off()
print("✅ 修复完成！现在的 Result_SHAP_Summary.pdf 应该是有内容的了！")
# ==========================================
# 优化版：只画 Top 20 的 SHAP 图
# ==========================================
library(ggplot2)
library(dplyr)
shap_df <- as.data.frame(shap_vals)
importance_scores <- data.frame(
Feature = names(shap_df),
Importance = colMeans(abs(shap_df))
)
top_20_features <- importance_scores %>%
arrange(desc(Importance)) %>%
head(20)
print("正在绘制 Top 20 SHAP 图...")
pdf("Result_SHAP_Summary_Top20.pdf", width = 8, height = 6)
ggplot(top_20_features, aes(x = reorder(Feature, Importance), y = Importance)) +
geom_col(fill = "#0073C2", width = 0.7) +
coord_flip() +
labs(
title = "Top 20 Most Important Features (SHAP Summary)",
subtitle = "Interpreting Model Decision Logic",
x = "Features",
y = "Average Impact on Prediction (mean |SHAP value|)"
) +
theme_minimal() +
theme(
axis.text.y = element_text(size = 10, face = "bold"),
plot.title = element_text(size = 14, face = "bold")
)
dev.off()
print("✅ 优化完成！请查看 Result_SHAP_Summary_Top20.pdf")
