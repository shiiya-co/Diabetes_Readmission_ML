# 删掉旧的 readmitted 列
select(-readmitted) %>%
# --- 步骤 D: 删除剩下的含有 NA 的行 ---
# 因为我们数据量很大(10万行)，直接删掉几千行有缺失值的行是安全的
drop_na()
# 4. 检查清洗后的结果
print("清洗前数据量:")
print(dim(raw_data))
print("清洗后数据量:")
print(dim(cleaned_data)) # 这里应该还有 9万多行，非常充足！
install.packages("tidyverse")
install.packages("data.table", type = "binary")
install.packages("tidyverse")
# 1. 加载必要的包 (如果没有安装，请先运行 install.packages("tidyverse"))
library(tidyverse)
# 2. 读取原始数据
# na.strings = "?" 非常重要，因为这个数据集用问号代表缺失
raw_data <- read.csv("diabetic_data.csv", na.strings = "?", stringsAsFactors = TRUE)
# 3. 数据清洗
cleaned_data <- raw_data %>%
# --- 步骤 A: 删除缺失率过高的列 ---
# weight (缺失97%), payer_code (缺失40%), medical_specialty (缺失47%)
select(-weight, -payer_code, -medical_specialty) %>%
# --- 步骤 B: 删除无用的 ID 列 (防止模型作弊) ---
# encounter_id, patient_nbr 是编号，对预测疾病无关
select(-encounter_id, -patient_nbr) %>%
# --- 步骤 C: 处理 Target (目标列) ---
# 原始数据有: "NO", ">30", "<30"。
# 我们把它简化成二分类问题：
# 0 = 没有再入院 (NO)
# 1 = 再入院了 (包含 >30 和 <30)
mutate(readmitted_binary = ifelse(readmitted == "NO", "No", "Yes")) %>%
mutate(readmitted_binary = as.factor(readmitted_binary)) %>%
# 删掉旧的 readmitted 列
select(-readmitted) %>%
# --- 步骤 D: 删除剩下的含有 NA 的行 ---
# 因为我们数据量很大(10万行)，直接删掉几千行有缺失值的行是安全的
drop_na()
# 4. 检查清洗后的结果
print("清洗前数据量:")
print(dim(raw_data))
print("清洗后数据量:")
print(dim(cleaned_data)) # 这里应该还有 9万多行，非常充足！
# 5. 保存清洗后的数据 (这是发给队友的关键文件！)
write.csv(cleaned_data, "cleaned_diabetes_data.csv", row.names = FALSE)
print("任务完成！文件 'cleaned_diabetes_data.csv' 已保存在你的文件夹里。")
install.packages("caret")          # 机器学习总管
install.packages("randomForest")   # 随机森林算法
install.packages("pROC")           # 画 ROC 曲线用的
install.packages("doParallel")     # 让训练速度变快（多核并行）
library(tidyverse)
library(caret)
library(randomForest)
library(pROC)
# 1. 读取刚才清洗好的数据
data <- read.csv("cleaned_diabetes_data.csv", stringsAsFactors = TRUE)
# --- 关键步骤：数据抽样 (为了速度) ---
# 原始数据有9万行，训练随机森林会很慢（可能要半小时）。
# 为了作业演示流畅，我们随机抽取 10% 的数据（约9000行）来训练。
# *注意：如果你电脑性能很好，可以跳过这一步，或者把 0.1 改成 0.3*
set.seed(123) # 保证每次抽样结果一样
sample_index <- createDataPartition(data$readmitted_binary, p = 0.1, list = FALSE)
small_data <- data[sample_index, ]
print(paste("用于训练的数据量:", nrow(small_data)))
# 1. 读取刚才清洗好的数据
data <- read.csv("cleaned_diabetes_data.csv", stringsAsFactors = TRUE)
# --- 关键步骤：数据抽样 (为了速度) ---
# 原始数据有9万行，训练随机森林会很慢（可能要半小时）。
# 为了作业演示流畅，我们随机抽取 10% 的数据（约9000行）来训练。
# *注意：如果你电脑性能很好，可以跳过这一步，或者把 0.1 改成 0.3*
set.seed(123) # 保证每次抽样结果一样
sample_index <- createDataPartition(data$readmitted_binary, p = 0.1, list = FALSE)
small_data <- data[sample_index, ]
print(paste("用于训练的数据量:", nrow(small_data)))
# 2. 拆分训练集 (70%) 和 测试集 (30%)
set.seed(42)
train_index <- createDataPartition(small_data$readmitted_binary, p = 0.7, list = FALSE)
train_set <- small_data[train_index, ]
test_set  <- small_data[-train_index, ]
# 3. 配置训练参数 (使用 5折交叉验证)
ctrl <- trainControl(
method = "cv",
number = 5,
classProbs = TRUE,  # 计算概率，画ROC曲线必须要有这个
summaryFunction = twoClassSummary
)
print("开始训练模型... (请耐心等待，可能需要1-3分钟)")
# 4. 开始训练随机森林模型
# 预测目标是 readmitted_binary，用所有其他列(.)作为特征
model_rf <- train(
readmitted_binary ~ .,
data = train_set,
method = "rf",
metric = "ROC",
trControl = ctrl,
ntree = 100,      # 树的数量，设为100由速度和精度折中
importance = TRUE # 计算特征重要性 (作业要求！)
)
print("模型训练完成！")
# 5. 在测试集上做“考试”
predictions <- predict(model_rf, test_set) # 预测类别 (Yes/No)
probs <- predict(model_rf, test_set, type = "prob") # 预测概率
# 6. 查看考试成绩 (混淆矩阵)
conf_matrix <- confusionMatrix(predictions, test_set$readmitted_binary)
print(conf_matrix)
# 7. 保存模型 (这是发给队友的关键文件！)
saveRDS(model_rf, "final_model.rds")
print("任务完成！'final_model.rds' 已保存。请把这个文件发给你的队友 B 和 C。")
library(tidyverse)
library(caret)
library(randomForest)
library(pROC)
# 1. 读取数据
print("正在读取数据...")
data <- read.csv("cleaned_diabetes_data.csv", stringsAsFactors = TRUE)
# 2. 数据抽样 (取10%以加快速度)
set.seed(123)
sample_index <- createDataPartition(data$readmitted_binary, p = 0.1, list = FALSE)
small_data <- data[sample_index, ]
print(paste("抽样后数据量:", nrow(small_data)))
# =======================================================
# 🚨 新增步骤：剔除“单一值”的列 (解决报错的核心！)
# =======================================================
print("正在检查并剔除无用的单一值列...")
# 找出方差为0（只有一种取值）的列
bad_cols <- nearZeroVar(small_data)
if(length(bad_cols) > 0) {
# 如果找到了坏列，就删掉它们
print(paste("发现了", length(bad_cols), "个无用列，正在删除..."))
# 打印一下删了哪些，方便写报告用
print(names(small_data)[bad_cols])
small_data <- small_data[, -bad_cols]
} else {
print("数据很完美，没有单一值的列。")
}
# 3. 拆分训练集 (70%) 和 测试集 (30%)
set.seed(42)
train_index <- createDataPartition(small_data$readmitted_binary, p = 0.7, list = FALSE)
train_set <- small_data[train_index, ]
test_set  <- small_data[-train_index, ]
# 4. 配置训练参数
ctrl <- trainControl(
method = "cv",
number = 5,
classProbs = TRUE,
summaryFunction = twoClassSummary
)
print("开始训练模型... (如果电脑风扇开始转是正常的)")
# 5. 开始训练随机森林
model_rf <- train(
readmitted_binary ~ .,
data = train_set,
method = "rf",
metric = "ROC",
trControl = ctrl,
ntree = 100,
importance = TRUE
)
